<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>CFBundleDisplayName</key>
    <string>Kiwio</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchScreenBackground</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Runtime config injected from Config.xcconfig via build settings.
         AppConfig.swift reads these at launch; missing keys cause a fatalError in DEBUG. -->
    <key>APP_ENVIRONMENT</key>
    <string>$(APP_ENVIRONMENT)</string>
    <key>SUPABASE_URL</key>
    <string>$(SUPABASE_URL)</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>$(SUPABASE_ANON_KEY)</string>
    <key>REVENUECAT_API_KEY</key>
    <string>$(REVENUECAT_API_KEY)</string>
    <key>SENTRY_DSN</key>
    <string>$(SENTRY_DSN)</string>
    <key>POSTHOG_API_KEY</key>
    <string>$(POSTHOG_API_KEY)</string>
    <key>POSTHOG_HOST</key>
    <string>$(POSTHOG_HOST)</string>
    <!-- Privacy usage descriptions (required by App Store review) -->
    <!-- Photo library only: meal scan flow relies on UIImagePickerController in .photoLibrary mode. -->
    <key>NSCameraUsageDescription</key>
    <string>Kiwio utilise la caméra pour photographier tes repas et lire le code-barres des produits, afin d'analyser ce qu'ils t'apportent.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>HealthMap accède à vos photos pour importer des images de repas ou d'étiquettes nutritionnelles que vous souhaitez analyser.</string>
    <!-- Saisie vocale (fonction phare) : dictée du repas via Speech.framework.
         Les DEUX clés sont obligatoires — sans elles l'app plante à la première
         dictée et la soumission est rejetée. La reconnaissance est demandée
         on-device quand l'appareil le permet : l'audio ne quitte pas le téléphone,
         seul le texte transcrit est envoyé à notre serveur pour être analysé. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Kiwio utilise le micro pour que tu puisses dicter ton repas au lieu de le saisir. L'enregistrement n'est pas conservé : seul le texte transcrit sert à identifier tes aliments.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Kiwio transcrit ta voix en texte pour reconnaître les aliments de ton repas et calculer tes calories. La transcription se fait sur ton iPhone quand il le permet ; sinon elle est traitée par les serveurs d'Apple. Seul le texte obtenu est envoyé à Kiwio, jamais l'enregistrement.</string>
    <!-- HealthKit : lecture seule (activité, poids, sommeil) pour pré-remplir le profil. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Kiwio lit ton activité, ton poids et ton sommeil depuis Apple Santé pour pré-remplir ton profil et personnaliser ton bilan. Lecture seule : Kiwio n'écrit jamais dans Santé.</string>
    <!-- Exigée par la validation App Store dès que l'entitlement HealthKit est présent,
         même en lecture seule. Kiwio n'écrit aucune donnée dans Santé. -->
    <key>NSHealthUpdateUsageDescription</key>
    <string>Kiwio n'écrit aucune donnée dans Apple Santé. Cette autorisation, requise par Apple pour les apps liées à Santé, n'est pas utilisée.</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- Push notifications (silent + user-facing) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    <!-- Deep Linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>healthmap</string>
            </array>
            <key>CFBundleURLName</key>
            <string>fr.healthmap.app</string>
        </dict>
    </array>
</dict>
</plist>
