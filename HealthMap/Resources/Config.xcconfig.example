// HealthMap — Build configuration (template)
//
// USAGE:
// 1. Copy this file to `Config.xcconfig` (same folder) — the real file is git-ignored.
// 2. Fill in your real values below.
// 3. In Xcode: Project > Info > Configurations > set both Debug and Release to use `Config` as the based configuration.
// 4. In Info.plist, make sure the keys SUPABASE_URL, SUPABASE_ANON_KEY, etc. are referenced as `$(SUPABASE_URL)`.
//
// IMPORTANT:
// - Never commit the real `Config.xcconfig` file to git.
// - Add `HealthMap/Resources/Config.xcconfig` to `.gitignore`.

// ==========================
// Environment
// ==========================
APP_ENVIRONMENT = development

// ==========================
// Supabase (required — DB + Edge Functions only, Auth is handled by Clerk)
// ==========================
// URL must be written without the `//` scheme separator because xcconfig treats `//` as a comment.
// Use `$()` escape: https:／／ trick — OR store it as a plain string in Info.plist and reference here.
SUPABASE_URL = https:/$()/ftwfxdfkghkemnpwtzlu.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here

// ==========================
// Clerk (required — primary auth provider since 20 avril 2026)
// ==========================
// PROD key = pk_live_Y2xlcmsuaGVhbHRobWFwLmZyJA (domaine clerk.healthmap.fr)
// Get from https://dashboard.clerk.com/apps/<app>/instances/<instance>/api-keys
CLERK_PUBLISHABLE_KEY = pk_live_Y2xlcmsuaGVhbHRobWFwLmZyJA

// ==========================
// RevenueCat (required for paywalls)
// ==========================
REVENUECAT_API_KEY = your_revenuecat_api_key_here

// ==========================
// Sentry (optional, strongly recommended)
// ==========================
SENTRY_DSN = your_sentry_dsn_here

// ==========================
// PostHog (optional)
// ==========================
POSTHOG_API_KEY = your_posthog_api_key_here
POSTHOG_HOST = https:/$()/eu.posthog.com
