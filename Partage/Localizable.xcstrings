          "stringUnit" : {
            "state" : "translated",
            "value" : "The figure shown is the share of the reference covered by your estimated intake."
          }
        }
      }
    },
    "Le corps garde le calcium du sang dans une fourchette serrée, quoi que tu manges : une prise de sang en dit peu sur tes apports en calcium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body keeps blood calcium within a narrow range whatever you eat, so a blood test says little about your calcium intake."
          }
        }
      }
    },
    "Le corps garde le magnésium du sang dans une fourchette serrée, quoi que tu manges : une prise de sang en dit peu sur tes apports en magnésium." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body keeps blood magnesium within a narrow range whatever you eat, so a blood test says little about your magnesium intake."
          }
        }
      }
    },
