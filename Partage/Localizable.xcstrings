          }
        }
      }
    },
    "Les repères pour les oméga-3 et les autres acides gras." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The benchmarks for omega-3 and other fatty acids."
          }
        }
      }
    },
    "Les règles et la grossesse changent tes besoins en fer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periods and pregnancy change your iron needs."
          }
        }
      }
    },
    "Les statuts" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The statuses"
          }
        }
      }
    },
    "Les statuts sont des estimations, pas des analyses sanguines. Une prise de sang récente prime sur l'estimation." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuses are estimates, not blood tests. A recent blood test takes precedence over the estimate."
          }
        }
      }
    },
    "Les symptômes que tu déclares dans ton bilan se suivent ici, jour après jour." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
