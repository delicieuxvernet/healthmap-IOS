# fastlane Fastfile — no-Mac TestFlight pipeline for HealthMap iOS.
# Signing: App Store Connect API key + fastlane match (appstore, readonly).
# Build: MANUAL signing with the match-installed profile (automatic signing is
# unreliable for Distribution on CI). Upload: pilot (TestFlight, no submission).
default_platform(:ios)

APP_ID = "fr.healthmap.app"

platform :ios do
  # ───────────────────────────────────────────────────────────────────────────
  # bootstrap — FIRST RUN ONLY. Génère le certificat de distribution +
  # provisioning profile via match (EN ÉCRITURE) et les stocke chiffrés dans
  # MATCH_GIT_URL.
  #
  # PRÉREQUIS (à créer manuellement UNE fois — `produce` via API key échoue
  # avec -20101 sur la création d'app ASC) :
  #   - App ID `fr.healthmap.app` : developer.apple.com → Certificates, IDs &
  #     Profiles → Identifiers → (+) → App IDs → App. Capabilities à cocher :
  #     Sign in with Apple, Push Notifications, Associated Domains.
  #   - App ASC : appstoreconnect.apple.com → Apps → (+) New App (iOS,
  #     bundle fr.healthmap.app, langue Français, SKU healthmap-ios-001).
  #
  # Après un bootstrap réussi, la lane `beta` (match readonly) suffit.
  # ───────────────────────────────────────────────────────────────────────────
  lane :bootstrap do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # Certificat Distribution + profil App Store via match EN ÉCRITURE.
    # Génère et stocke (chiffré) dans MATCH_GIT_URL au premier run.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      storage_mode: "git",
      readonly: false,
      api_key: api_key
    )
  end

  desc "Resolve match, build with manual signing, upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # Dedicated unlocked keychain so codesign never hits an interactive prompt.
    # On CI, the default `login.keychain-db` is password-protected with no UI ->
    # codesign hangs forever waiting for an authorization popup that never comes
    # (observed: 55 min stuck on "Signing Sentry.framework" before the 60-min
    # job timeout killed it). With keychain_name + keychain_password specified
    # to match, the imported P12 is also "set-key-partition-list" allowed for
    # codesign without prompting.
    keychain_name = "build.keychain"
    keychain_password = "tempBuildPass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 0,             # 0 = never lock (whole-job duration)
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      storage_mode: "git",
      readonly: true,
      api_key: api_key,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # Resolve the installed App Store profile name defensively. match populates
    # lane_context[:MATCH_PROVISIONING_PROFILE_MAPPING] and an env var whose
    # exact key has varied across fastlane versions — so we try several known
    # sources and fail LOUD with diagnostics rather than guess wrong silently.
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    profile_name = mapping[APP_ID] ||
                   mapping["#{APP_ID}.appstore"] ||
                   ENV["sigh_#{APP_ID}_appstore_profile-name"] ||
                   ENV["sigh_#{APP_ID}_appstore"]

    if profile_name.nil? || profile_name.to_s.empty?
      sh("env | grep -i 'sigh_\\|match_' || true")  # first-run diagnostics
      UI.user_error!("Could not resolve the match App Store profile name. " \
        "Inspect the env/lane_context dump above and set the correct key.")
    end
    UI.message("Using provisioning profile: #{profile_name}")

    # NOTE quoting : le nom de profil match contient des espaces
    # ("match AppStore fr.healthmap.app"). Le passer dans xcargs via
    # PROVISIONING_PROFILE_SPECIFIER=#{profile_name} sans guillemets fait que
    # xcodebuild lit "AppStore" comme une build action → "Unknown build action".
    # On le passe donc UNIQUEMENT via export_options.provisioningProfiles (mapping
    # propre, géré par gym) + on quote le specifier dans xcargs par sécurité.
    build_app(
      project: "HealthMap.xcodeproj",
      scheme: "HealthMap",
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build",
      output_name: "HealthMap.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("FASTLANE_TEAM_ID"),
        provisioningProfiles: { APP_ID => profile_name }
      }
      # NB: signing is deliberately NOT passed via xcargs. Global xcargs apply to
      # EVERY target, including SPM packages (RevenueCat, swift-crypto...) which
      # "do not support provisioning profiles" -> archive error (exit 65). The
      # app target's Release config in project.yml carries CODE_SIGN_STYLE=Manual
      # + CODE_SIGN_IDENTITY="Apple Distribution" + PROVISIONING_PROFILE_SPECIFIER
      # (per-target). export_options above stays per-bundle-id (app only).
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/HealthMap.ipa",
      app_identifier: APP_ID,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end

  # ───────────────────────────────────────────────────────────────────────────
  # refresh_profiles — régénère le provisioning profile App Store EN ÉCRITURE
  # (force: true) pour qu'il intègre une capability fraîchement cochée sur
  # l'App ID (ex. HealthKit). À lancer UNE FOIS après avoir activé la capability
  # dans le portail Apple Developer ; ensuite la lane `beta` (match readonly)
  # télécharge le profil à jour. `force` ne régénère QUE le profil — le
  # certificat de distribution existant est réutilisé, jamais révoqué.
  # ───────────────────────────────────────────────────────────────────────────
  lane :refresh_profiles do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: APP_ID,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      storage_mode: "git",
      readonly: false,
      force: true,
      api_key: api_key
    )
  end
end

# VERIFY ON FIRST RUN (could not be fully confirmed from docs — training data
# on fastlane internals is unreliable):
#  - The exact match profile-name source: the diagnostic `env | grep sigh_`
#    above prints it on first failure so the resolver list can be corrected.
#  - DEVELOPMENT_TEAM: injected explicitly via xcargs
#    (DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']}) AND baked into project.yml
#    (D87R3L7B75). Manual signing on CI requires the team at ARCHIVE time, not
#    just at export — without it xcodebuild fails: "Signing for HealthMap
#    requires a development team" (exit 65). Fixed 2026-06-03.
#  - The App Store Connect app record for fr.healthmap.app must exist before
#    upload_to_testflight (pilot does not create it).
