# fastlane Appfile
# team_id = the 10-char Apple Developer Team ID that owns fr.healthmap.app.
# Provided via the FASTLANE_TEAM_ID GitHub secret (set after Apple enrollment).
app_identifier("fr.healthmap.app")
team_id(ENV["FASTLANE_TEAM_ID"].to_s.empty? ? "REPLACE_WITH_TEAM_ID" : ENV["FASTLANE_TEAM_ID"])
